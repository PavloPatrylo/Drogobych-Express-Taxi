# Стейдж 1: Збірка Vite / React / Node.js застосунку
FROM node:20-alpine AS build

WORKDIR /app

# Копіюємо конфігурації залежностей
COPY frontend/package*.json ./

RUN npm install

# Копіюємо весь вихідний код фронтенду
COPY frontend/ ./

# Будуємо продакшн-версію
RUN npm run build

# Стейдж 2: Роздача статичних файлів через Nginx
FROM nginx:alpine

# Копіюємо зібрані файли з першого стейджу в папку Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Копіюємо власний конфіг Nginx для коректного роутингу (SPA fallback)
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
