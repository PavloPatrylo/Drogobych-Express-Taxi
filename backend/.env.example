# Налаштування БД для локального запуску та Docker Compose
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=taxi_db

# Токен Telegram Бота та Секретний ключ
BOT_TOKEN=your_telegram_bot_token_here
SECRET_KEY=your_secret_key_here

# Налаштування Ngrok тунелю
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=fletcher-inordinate-leontine.ngrok-free.dev
