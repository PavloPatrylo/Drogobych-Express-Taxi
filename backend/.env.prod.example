# --- PRODUCTION ENVIRONMENT CONFIGURATION ---
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=generate_a_very_strong_random_secret_key_here
CORS_ORIGINS=["https://express-taxi.ua", "https://admin.express-taxi.ua"]

# Database settings
DB_USER=drogobych_prod_admin
DB_PASSWORD=secure_prod_password_must_be_changed
DB_NAME=drogobych_express_prod_db
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://drogobych_prod_admin:secure_prod_password_must_be_changed@postgres:5432/drogobych_express_prod_db

# Telegram Bot Token & Production WebApp URL
BOT_TOKEN=your_production_bot_token_here
WEB_APP_URL=https://express-taxi.ua

# Image Registry settings
DOCKER_IMAGE_NAME=pavlo/taxi-backend
DOCKER_IMAGE_TAG=latest
